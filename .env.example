# ==============================================================================
# ULevelP 서버 환경 변수 템플릿 (.env.example)
# 복사하여 .env 파일을 생성한 뒤 실제 값을 채워 넣어주세요:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase 인증 및 녹음 스토리지 (K1-2, K1-3 실환경 필수)
# ------------------------------------------------------------------------------
# Supabase 대시보드 -> Project Settings -> API 에서 확인
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase Storage 버킷('takes') 업로드 및 서명 URL 생성을 위한 관리자 키
# 확인 위치: Supabase 대시보드 -> Project Settings -> API -> Project API keys -> 'service_role' (secret)
# ※ 주의: 브라우저에 노출되는 anon/publishable 키가 아니라 서버 전용 비공개 키입니다.
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 2. 데이터베이스 연결 (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# 확인 위치: Supabase 대시보드 -> Project Settings -> Database -> Connection string -> URI
# 권장: Session 모드 풀러 포트(5432) 또는 Direct 연결
# DATABASE_URL 또는 REMOTE_DB_URL 중 하나를 설정합니다.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
# REMOTE_DB_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# (선택) DATABASE_URL 대신 개별 파라미터로 설정할 경우:
# REMOTE_DB_HOST=aws-0-<region>.pooler.supabase.com
# REMOTE_DB_PORT=5432
# REMOTE_DB_NAME=postgres
# REMOTE_DB_USER=postgres.<project-ref>
# REMOTE_DB_PASSWORD=[YOUR-PASSWORD]

# ------------------------------------------------------------------------------
# 3. Ktor 서버 구동 및 CORS 설정 (선택 - 기본값 제공)
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
PUBLIC_DIR=public
PUBLIC_APP_URL=http://localhost:3000/
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://hunseokc.github.io

# ------------------------------------------------------------------------------
# 4. 앱 내부 토큰 암호화 마스터 키 (K0-2 / K4-1 외부 연동 키 보관용)
# ------------------------------------------------------------------------------
# AES-256-GCM 32바이트 암호화 키 (Base64 인코딩)
# 생성 명령: openssl rand -base64 32
APP_MASTER_KEY=
